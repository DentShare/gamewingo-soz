{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "types": ["vite/client", "vitest/globals"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "strict": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src"]
}
